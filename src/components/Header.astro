---
const base = import.meta.env.BASE_URL;

const path = (url: string) => `${base}${url}`.replace(/\/\/+/g, '/');
---

<header >
  <div class="navbar" >
    <button class="menu-toggle" id="openDrawer">☰</button>

    <div class="logo">
      <img src={path('assets/icono.svg')} alt="logo" />
      <span>AVAI</span>
    </div>

    <nav class="tabs" transition:persist>
      <a class="tab" href={base}>
        Inicio
      </a>

      <a class="tab" href={path('servicios')}>
        Servicios
      </a>

      <a class="tab" href={path('nosotros')}>
        Nosotros
      </a>

      <a class="tab" href={path('casosExitos')}>
        Casos de Éxito
      </a>

      <span class="tab-indicator"></span>
    </nav>

    <div class="nav-right">
      <button
        class="btn primary-color uppercase medium flat text-secondary-dark"
        onclick="openWhatsApp('Quiero información sobre los servicios de AVAI')"
      >
        Contáctanos
      </button>
    </div>
  </div>
  <!-- OVERLAY -->
    <div id="overlay" class="overlay"></div>

    <!-- DRAWER -->
    <div id="drawer" class="drawer">
      <div class="drawer-header">
        <div class="logo">
          <img src={path('assets/icono.svg')} alt="logo" />
          <span>AVAI</span>
        </div>
        <button class="close-btn" id="closeDrawer">✕</button>
      </div>

      <a href={base}>Inicio</a>

      <a href={path('servicios')}>
        Servicios
      </a>
      <a href={path('nosotros')}>
        Nosotros
      </a>
      <a href={path('casosExitos')}>
        Casos de Éxito
      </a>
    </div>
   
</header>
