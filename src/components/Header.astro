---
const pathname = Astro.url.pathname;
---

<header >
  <div class="navbar" >
    <button class="menu-toggle" id="openDrawer">☰</button>

    <div class="logo">
      <img src="/assets/icono.svg" alt="logo" />
      <span>AVAI</span>
    </div>

    <nav class="tabs" transition:persist>
      <a class="tab" href="/">
        Inicio
      </a>

      <a class="tab" href="/servicios">
        Servicios
      </a>

      <a class="tab" href="/nosotros">
        Nosotros
      </a>

      <a class="tab" href="/casosExitos">
        Casos de Éxito
      </a>

      <span class="tab-indicator"></span>
    </nav>

    <div class="nav-right">
      <button
        class="btn primary-color uppercase medium flat text-secondary-dark"
        onclick="openWhatsApp('Quiero información sobre los servicios de AVAI')"
      >
        Contáctanos
      </button>
    </div>
  </div>
  <!-- OVERLAY -->
    <div id="overlay" class="overlay"></div>

    <!-- DRAWER -->
    <div id="drawer" class="drawer">
      <div class="drawer-header">
        <div class="logo">
          <img src="/assets/icono.svg" alt="logo" />
          <span>AVAI</span>
        </div>
        <button class="close-btn" id="closeDrawer">✕</button>
      </div>

      <a href="/">Inicio</a>

      <a href="/servicios">
        Servicios
      </a>
      <a href="/nosotros">
        Nosotros
      </a>
      <a href="/casosExitos">
        Casos de Éxito
      </a>
    </div>
   
</header>
