---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <!-- LEFT -->
  <div class="hero-content">
    <span>
      <h2 class="hero-tag">
        <i class="mr-2 d-flex"><img src={`${base}assets/code-file.svg`} alt="ícono" /> </i>
        EFICIENCIA OPERATIVA
      </h2>
    </span>

    <h3 class="hero-title">
      Software que reduce
      <span>costos operativos.</span>
      <br />
      Resultados medibles.
    </h3>

    <p class="hero-description">
      Diseñamos plataformas y sistemas digitales orientados a optimizar procesos, reducir tiempos
      operativos y escalar la productividad de tu empresa.
    </p>

    <div class="hero-action">
      <button
        class="btn primary-color flat"
        onclick="openWhatsApp('Quiero solicitar un diagnóstico gratis para mi empresa')"
      >
        Solicitar Diagnóstico Gratis
      </button>

      <button
        class="btn text-light outlined"
        onclick="
                  openWhatsApp(
                    'Quiero solicitar un diagnóstico gratis para mi empresa y ver soluciones'
                  )
                "
      >
        Ver Soluciones
      </button>
    </div>
  </div>

  <!-- RIGHT -->
  <div class="hero-image">
    <img src={`${base}assets/hero.png`} alt="Software empresarial" />

    <div class="container-overlay">
      <div class="overlay-card">
        <h3>optimización</h3>

        <h4 class="overlay-card-title">40%</h4>

        <p class="overlay-card-description">Reducción de costos</p>
      </div>

      <div class="overlay-card">
        <h3>productividad</h3>

        <h4 class="overlay-card-title">12h</h4>

        <p class="overlay-card-description">Ahorro semanal</p>
      </div>
    </div>

    <div class="gradiant"></div>
  </div>
</section>
