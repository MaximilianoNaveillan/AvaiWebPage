---
const base = import.meta.env.BASE_URL;
---

<section class="container">
    <article>
      <div class="grid-items grid-items-3-1">
        <div class="grid-item elevation" style="width: 100%; flex: 668px">
          <div class="d-flex flex-center">
            <img
              class="rounded elevation-1"
              style="width: 100%; max-width: 100%"
              src={`${base}assets/optimizacion-de-Inventarios.png`}
              alt="Optimización de Inventarios"
            />
          </div>
        </div>
        <div class="grid-item">
          <div class="mb-3">
            <h2>
              <span class="hero-tag text-soft mt-0 mb-3">
                <i class="mr-3 d-flex py-1"><img src={`${base}assets/box.svg`} alt="ícono" /> </i>
                SECTOR LOGÍSTICO</span
              >Optimización de Inventarios
            </h2>
          </div>
          <div class="bg-strong pa-5 my-5">
            <h3 class="font-14 text-secondary letter-spacing-2 mb-2">RETO</h3>
            <p class="font-14">
              Exceso de stock inmovilizado y falta de visibilidad en tiempo real de la
              rotación de SKU críticos.
            </p>
          </div>
          <div class="bg-soft pa-5 my-5" style="border-left: 4px solid var(--primary)">
            <h3 class="font-14 text-secondary letter-spacing-2 mb-2">SOLUCIÓN TÉCNICA</h3>
            <p class="font-14">
              Implementación de un modelo predictivo basado en IA para el balanceo de
              inventarios y sensorización de racks.
            </p>
          </div>
          <div class="d-flex pa-5 my-5 space-between bg-primary rounded-small elevation-1">
            <div>
              <p class="d-block text-primary-dark">
                <span class="d-block font-32 f-w-bold">-22%</span>
                <span class="d-block font-12 f-w-600 letter-spacing-2"
                  >STOCK INMOVILIZADO</span
                >
              </p>
            </div>
            <div class="d-flex flex-center">
              <img style="width: 40px" src={`${base}assets/graphic-arrow.svg`} alt="flecha" />
            </div>
          </div>
        </div>
      </div>
    </article>
</section>
