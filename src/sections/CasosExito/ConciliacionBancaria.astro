---
const base = import.meta.env.BASE_URL;
---

<section class="container">
  <article>
    <div class="grid-items grid-items-3-1">
      <div class="grid-item" style="width: 100%; flex: 668px">
        <div class="mb-3">
          <h2>
            <span class="hero-tag text-soft mt-0 mb-3">
              <i class="mr-3 d-flex py-1">
                 <img src={`${base}assets/box.svg`} alt="ícono" />
              </i>
              SECTOR FINANCIERO
            </span>

            <span class="d-block">
              Automatización de Conciliación Bancaria
            </span>
          </h2>
        </div>

        <div class="d-flex flex-row f-wrap gap-20">
          <div style="flex: 300px" class="bg-strong pa-5 rounded">
            <h3 class="font-14 text-secondary letter-spacing-2 mb-2">
              RETO
            </h3>

            <p class="font-14">
              Exceso de stock inmovilizado y falta de visibilidad en tiempo real
              de la rotación de SKU críticos.
            </p>
          </div>

          <div style="flex: 300px" class="bg-strong pa-5 rounded">
            <h3 class="font-14 text-secondary letter-spacing-2 mb-2">
              SOLUCIÓN TÉCNICA
            </h3>

            <p class="font-14">
              Desarrollo de un motor de reglas RPA para el match automático de
              transacciones multicanal.
            </p>
          </div>
        </div>

        <div class="d-flex flex-row flex-center f-wrap gap-20 mt-5">
          <div class="bg-dark pa-5 rounded">
            <p class="d-block text-primary-dark text-center">
              <span class="d-block font-28 f-w-bold text-primary">40h</span>

              <span
                class="d-block font-12 f-w-600 letter-spacing-2 text-white-light"
              >
                AHORRO MENSUAL
              </span>
            </p>
          </div>

          <div
            style="flex: 400px"
            class="bg-strong pa-5 rounded d-flex flex-center"
          >
            <div class="list-item pt-2 w-100">
              <div class="list-icon">
                <i>
                  <img
                    src={`${base}assets/check-background-icon.svg`}
                    alt="dashboard-icon"
                  />
                </i>
              </div>

              <div class="list-section">
                <h6>99.9% de Precisión</h6>

                <p class="text-light">
                  Eliminación total de discrepancias por entrada manual de datos.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid-item">
        <img
          class="rounded-small elevation-1"
          style="width: 100%; max-width: 100%"
          src={`${base}assets/automatizacion-bancaria.png`}
          alt="Automatización Bancaria"
        />
      </div>
    </div>
  </article>
</section>
