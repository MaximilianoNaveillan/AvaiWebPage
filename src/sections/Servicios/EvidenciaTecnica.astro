---
const base = import.meta.env.BASE_URL;
---

<section class="container bg-dark">
  <article>
    <div class="grid-items grid-items-2 gap-30">
      <div>
        <h3 class="text-primary">Evidencia Técnica</h3>
        <p class="font-16 py-4 text-white-light">
          Nuestros despliegues no son suposiciones, son activos financieros optimizados por
          ingeniería
        </p>
        <div class="list mt-4">
          <div class="list-item">
            <div class="list-icon">
              <i>
                <img src={`${base}assets/dashboard-background-icon.svg`} alt="dashboard-icon" />
              </i>
            </div>
            <div class="list-section">
              <h6>99.9% Uptime Garantizado</h6>
              <p>Arquitecturas basadas en microservicios con alta disponibilidad nativa.</p>
            </div>
          </div>
          <div class="list-item">
            <div class="list-icon">
              <i>
                <img src={`${base}assets/protected-background-icon.svg`} alt="protected-icon" />
              </i>
            </div>
            <div class="list-section">
              <h6>Cifrado de Grado Militar</h6>
              <p>Protección de datos críticos bajo normativas internacionales de ciberseguridad.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="row-2 gap-20 f-wrap" style="flex: 300px">
        <div
          class="grid-item-card w-100 d-flex gap-20 flex-column space-around"
          style="background-color: rgba(255, 255, 255, 0.06)"
        >
          <div class="row-2 w-100">
            <h6 class="d-flex flex-center flex-column w-100" style="text-align: center">
              <span class="font-32 text-primary">+150</span>
              <span class="font-12 f-w-500 text-white-light w-100">PROYECTOS ENTREGADOS</span>
            </h6>
            <h6 class="d-flex flex-center flex-column w-100" style="text-align: center">
              <span class="font-32 text-primary">12ms</span>
              <span class="font-12 f-w-500 text-white-light w-100">LATENCIA DE RESPUESTA</span>
            </h6>
          </div>
          <div class="row-2 w-100">
            <h6 class="d-flex flex-center flex-column w-100" style="text-align: center">
              <span class="font-32 text-primary">94%</span>
              <span class="font-12 f-w-500 text-white-light">SATISFACCIÓN CLIENTE</span>
            </h6>
            <h6 class="d-flex flex-center flex-column w-100" style="text-align: center">
              <span class="font-32 text-primary">24/7</span>
              <span class="font-12 f-w-500 text-white-light">MONITORIZACIÓN REAL</span>
            </h6>
          </div>
        </div>
      </div>
    </div>
  </article>
</section>
